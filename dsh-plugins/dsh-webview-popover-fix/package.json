{
  "name": "dsh-webview-popover-fix",
  "version": "0.1.2",
  "description": "DeepSeek Harness 插件：修复长转录会话里 CSS 锚定浮层被定位到视口外的问题（命令菜单 / 权限 / 模型 / Token 用量 / 问答卡片点了没反应）。",
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "cordis",
    "plugin",
    "vscode",
    "webview",
    "popover",
    "anchor"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "author": {
    "name": "ZSCaiGou",
    "url": "https://github.com/ZSCaiGou"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ZSCaiGou/dsh-webview-popover-fix.git"
  },
  "homepage": "https://github.com/ZSCaiGou/dsh-webview-popover-fix#readme",
  "bugs": {
    "url": "https://github.com/ZSCaiGou/dsh-webview-popover-fix/issues"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*"
  }
}
